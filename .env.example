# Copy to .env; never commit a real key. Environment variables override this file.
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
# Local policy (20 requests/minute), NOT a verified NVIDIA quota.
JARVIS_REQUEST_INTERVAL=3
JARVIS_REQUEST_TIMEOUT=45
JARVIS_MAX_RETRIES=2
JARVIS_MAX_RETRY_WAIT=30
JARVIS_MAX_TOKENS=2048
